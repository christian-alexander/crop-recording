#!/usr/bin/python3
"""Run Crop Recording in an Ubuntu X11 desktop session."""
import argparse
from datetime import datetime
from itertools import combinations
import os
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import tempfile
import time


def say(message):
    print(message, file=sys.stderr, flush=True)


def region_arg(value):
    if not re.fullmatch(r"[0-9]+,[0-9]+,[0-9]+,[0-9]+", value):
        raise argparse.ArgumentTypeError("Use the format X,Y,WIDTH,HEIGHT.")
    return tuple(map(int, value.split(",")))


class Shortcuts:
    def __init__(self, connection, root):
        from Xlib import X, XK

        self.connection = connection
        self.root = root
        lock_codes = {connection.keysym_to_keycode(XK.string_to_keysym(name))
                      for name in ("Num_Lock", "Scroll_Lock")}
        ignored = {X.LockMask}
        for index, keycodes in enumerate(connection.get_modifier_mapping()):
            if (set(keycodes) - {0}) & lock_codes:
                ignored.add(1 << index)
        self.mask = 0xff & ~sum(ignored)
        self.extras = {sum(subset) for size in range(len(ignored) + 1)
                       for subset in combinations(ignored, size)}
        self.enter = {(self.keycode(name), X.ControlMask) for name in ("Return", "KP_Enter")}
        self.enter = {key for key in self.enter if key[0]}
        if not self.enter:
            raise ValueError("Could not find an Enter key in the X11 keyboard map.")
        self.escape = self.keycode("Escape"), 0

    def keycode(self, name):
        from Xlib import XK

        return self.connection.keysym_to_keycode(XK.string_to_keysym(name))

    def grab(self, binding, name):
        from Xlib import X, error

        code, mask = binding
        errors = []
        for extra in self.extras:
            handler = error.CatchError()
            self.root.grab_key(code, mask | extra, False, X.GrabModeAsync, X.GrabModeAsync,
                               onerror=handler)
            errors.append((extra, handler))
        self.connection.sync()
        if any(handler.get_error() for _, handler in errors):
            for extra, handler in errors:
                if not handler.get_error():
                    self.root.ungrab_key(code, mask | extra)
            self.connection.flush()
            raise ValueError(f"Could not register {name}. It may already be in use.")

    def ungrab(self, binding):
        code, mask = binding
        for extra in self.extras:
            self.root.ungrab_key(code, mask | extra)
        self.connection.flush()


def notify(title, body):
    try:
        subprocess.run(["notify-send", "--app-name=Crop Recording", title, body],
                       check=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        say("Could not send a desktop notification.")


class Recording:
    def __init__(self, display_name, region):
        x, y, width, height = region
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        self.folder = Path(tempfile.mkdtemp(prefix="crop-recording-", dir="/tmp"))
        self.path = self.folder / f"crop-recording-{stamp}.mp4"
        self.partial = self.folder / "recording.part.mp4"
        self.frames = 0
        self.progress = b""
        try:
            self.process = subprocess.Popen([
                "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostats",
                "-stats_period", "0.15", "-progress", "pipe:1",
                "-f", "x11grab", "-framerate", "30", "-video_size", f"{width}x{height}",
                "-grab_x", str(x), "-grab_y", str(y), "-i", display_name,
                "-an", "-c:v", "libx264rgb", "-qp", "0", "-preset", "slow",
                "-fps_mode", "passthrough", "-movflags", "+faststart", str(self.partial),
            ], stdin=subprocess.PIPE, stdout=subprocess.PIPE, start_new_session=True)
        except OSError:
            self.folder.rmdir()
            raise

    def update_progress(self, data):
        lines = (self.progress + data).split(b"\n")
        self.progress = lines.pop()
        for line in lines:
            if line.startswith(b"frame="):
                self.frames = int(line.split(b"=", 1)[1])

    def finish(self):
        encoder = self.process
        try:
            data, _ = encoder.communicate(input=b"q\n", timeout=20)
        except subprocess.TimeoutExpired:
            encoder.kill()
            data, _ = encoder.communicate()
        self.update_progress(data)
        if encoder.returncode or not self.frames or not self.partial.is_file():
            self.partial.unlink(missing_ok=True)
            self.folder.rmdir()
            say("Recording failed or stopped before capturing any frames.")
            notify("Recording failed", "No MP4 was saved.")
            return
        self.partial.rename(self.path)
        return self.path


class CropRecording:
    def __init__(self, connection, display_name, region):
        from delivery import FileClipboard

        self.connection = connection
        self.display_name = display_name
        self.region = region
        self.root = connection.screen().root
        self.shortcuts = Shortcuts(connection, self.root)
        self.escape_grabbed = False
        self.held_keys = set()
        self.picker = self.overlay = self.recording = None
        self.clipboard = FileClipboard()
        self.result = None
        for binding in self.shortcuts.enter:
            self.shortcuts.grab(binding, "Ctrl+Enter")
        say("Crop Recording is ready. Press Ctrl+Enter to open the area picker.")

    def open_picker(self):
        from overlay import Picker

        try:
            self.shortcuts.grab(self.shortcuts.escape, "Esc")
            self.escape_grabbed = True
            size = self.root.get_geometry()
            self.picker = Picker(size.width, size.height, self.region)
        except (OSError, RuntimeError, ValueError) as exc:
            self.close_session()
            self.report_error(exc)

    def close_picker(self):
        if self.picker:
            self.picker.close()
            self.picker = None
        if self.escape_grabbed:
            self.shortcuts.ungrab(self.shortcuts.escape)
            self.escape_grabbed = False

    def start_recording(self):
        from overlay import RecordingOverlay

        picker = self.picker
        region = picker.region
        width, height = picker.width, picker.height
        self.close_picker()
        try:
            self.overlay = RecordingOverlay(width, height, region)
            self.recording = Recording(self.display_name, region)
            self.overlay.started = time.monotonic()
            say("Recording started.")
        except (OSError, RuntimeError, ValueError) as exc:
            self.close_session()
            self.report_error(exc)

    def close_session(self, show_result=True, timestamp=0):
        path = None
        try:
            if self.recording:
                recording, self.recording = self.recording, None
                path = recording.finish()
        except OSError as exc:
            self.report_error(exc)
        finally:
            if self.overlay:
                self.overlay.close()
                self.overlay = None
            self.close_picker()
        if path and show_result:
            from delivery import RecordingDialog

            self.result = RecordingDialog(path, self.clipboard, self.result_finished, timestamp)
        elif path:
            self.result_finished(path, None)
        if not show_result and self.result:
            self.result.close(self.result.path)

    def result_finished(self, path, message):
        self.result = None
        print(path, flush=True)
        if message:
            notify("Recording finished", message)

    def report_error(self, exc):
        say(f"crop-recording: {exc}")
        notify("Crop Recording", str(exc))

    def tick(self):
        from Xlib import X

        if self.recording:
            progress = self.recording.process.stdout.fileno()
            if select.select([progress], [], [], 0)[0]:
                self.recording.update_progress(os.read(progress, 4096))
            if self.recording.process.poll() is not None:
                self.close_session()
            else:
                self.overlay.update()

        while self.connection.pending_events():
            event = self.connection.next_event()
            if event.type != X.KeyPress or event.detail in self.held_keys:
                continue
            key = event.detail, event.state & self.shortcuts.mask
            if key in self.shortcuts.enter:
                if self.recording:
                    self.close_session(timestamp=event.time)
                elif self.picker:
                    if self.picker.ready:
                        self.start_recording()
                elif not self.result:
                    self.open_picker()
            elif self.picker and key == self.shortcuts.escape:
                self.close_session()
            else:
                continue
            self.held_keys.add(event.detail)
        if self.held_keys:
            keys = self.connection.query_keymap()
            self.held_keys = {code for code in self.held_keys
                              if keys[code // 8] & (1 << (code % 8))}
        return True


def run(region):
    from Xlib import display
    from Xlib.error import DisplayError

    display_name = os.environ.get("DISPLAY")
    if os.environ.get("XDG_SESSION_TYPE") == "wayland" or os.environ.get("WAYLAND_DISPLAY"):
        raise ValueError("Crop Recording requires X11 (Ubuntu on Xorg).")
    if not display_name:
        raise ValueError("Crop Recording requires an X11 desktop session.")
    os.environ["GDK_BACKEND"] = "x11"
    os.environ["GDK_SCALE"] = "1"
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib" / "crop-recording"))
    from overlay import Gtk
    from gi.repository import GLib

    if not Gtk.init_check()[0]:
        raise ValueError("Could not open the GTK display on X11.")
    try:
        connection = display.Display(display_name)
    except DisplayError as exc:
        raise ValueError(str(exc)) from exc
    try:
        daemon = CropRecording(connection, display_name, region)
        loop = GLib.MainLoop()

        def quit_requested():
            loop.quit()
            return GLib.SOURCE_REMOVE

        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, quit_requested)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, quit_requested)
        GLib.timeout_add(30, daemon.tick)
        try:
            loop.run()
        finally:
            daemon.close_session(show_result=False)
    finally:
        connection.close()


def main():
    os.environ["LANGUAGE"] = "en"
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--region", type=region_arg, metavar="X,Y,LEBAR,TINGGI",
                        help="preselect an area by coordinates, or drag to select without this option")
    args = parser.parse_args()
    try:
        run(args.region)
    except (ValueError, OSError, ImportError, argparse.ArgumentTypeError) as exc:
        say(f"crop-recording: {exc}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
